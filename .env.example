# Backend: defaults are local, synthetic, loopback only. Never commit secrets.
GRANTTHREAD_MODE=local
GRANTTHREAD_DATA_DIR=.data
AWS_REGION=eu-west-1
# Explicit regional Bedrock model ID; leave empty until account access is verified.
BEDROCK_MODEL_ID=
# Cloud-only resources populated from SAM outputs:
GRANTTHREAD_TABLE=
GRANTTHREAD_BUCKET=
GRANTTHREAD_QUEUE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Frontend public configuration, copied to frontend/.env.local if needed:
VITE_API_URL=/api
VITE_BASE_PATH=/
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=
